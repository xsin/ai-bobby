{
  "name": "@ai-bobby/cli",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "无界面启动器：只运行网关与模型服务，便于调试与脚本化",
  "bin": {
    "ai-bobby": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts serve",
    "status": "tsx src/index.ts status",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-bobby/core": "workspace:*",
    "@ai-bobby/gateway": "workspace:*",
    "@ai-bobby/workbuddy": "workspace:*",
    "@ai-bobby/opencode": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
